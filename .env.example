# Copy this file to a file named exactly ".env" in this same folder, then put
# your own Groq API key on the line below. The agent reads the key from this
# file at start-up (via python-dotenv) and never prints it.
#
# Get a key at https://console.groq.com/keys
#
# The deterministic core of the agent runs completely offline: the test suite
# and every "--stub" run work with no key and no internet connection. A key is
# only needed for live runs against Llama 3.3 on Groq.

GROQ_API_KEY=gsk_replace_this_with_your_own_key
